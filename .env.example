# Optional reputation and search provider settings.
PHISHINTEL_GOOGLE_SAFE_BROWSING_KEY=
PHISHINTEL_VIRUSTOTAL_KEY=
PHISHINTEL_BING_KEY=
PHISHINTEL_URLHAUS_ENABLED=false

# Common CLI settings.
PHISHINTEL_TIMEOUT=8.0
PHISHINTEL_STDOUT=false
PHISHINTEL_NO_PROGRESS=false

# Resource parser settings.
PHISHINTEL_RESOURCE_MAX_PAGES=500
PHISHINTEL_RESOURCE_MAX_DEPTH=8
PHISHINTEL_RESOURCE_CONCURRENCY=8

# Comma-separated User-Agent pool. Empty uses the built-in crawler User-Agent.
# Example:
# PHISHINTEL_RESOURCE_USER_AGENTS=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/131.0 Safari/537.36,Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/131.0 Safari/537.36
PHISHINTEL_RESOURCE_USER_AGENTS=

# Comma-separated HTTP/HTTPS proxy URLs. Empty uses a direct connection.
# Example:
# PHISHINTEL_RESOURCE_PROXIES=http://proxy-01.example:8080,http://proxy-02.example:8080
PHISHINTEL_RESOURCE_PROXIES=

# Local history storage.
PHISHINTEL_HISTORY_FILE=data/history.jsonl

# Bundled TCP port scanner.
PHISHINTEL_PORTSCAN_BINARY=
PHISHINTEL_PORTSCAN_TIMEOUT=45