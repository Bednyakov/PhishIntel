# API keys.
PHISHINTEL_GOOGLE_SAFE_BROWSING_KEY=
PHISHINTEL_VIRUSTOTAL_KEY=
PHISHINTEL_BING_KEY=
# Example values: true / false
PHISHINTEL_URLHAUS_ENABLED=false

# Common CLI defaults
PHISHINTEL_TIMEOUT=8.0
PHISHINTEL_STDOUT=false
PHISHINTEL_NO_PROGRESS=false

# Domain scan defaults
# Example values: quick / full / security
PHISHINTEL_DOMAIN_PROFILE=full
# Comma-separated list. Example: nmap,nuclei
PHISHINTEL_ACTIVE_TOOLS=

# Username search defaults
# Example: PHISHINTEL_USERNAME_WORKERS=20
PHISHINTEL_USERNAME_WORKERS=12
# Example: PHISHINTEL_USERNAME_WORDLIST=wordlists/username_sites.txt
PHISHINTEL_USERNAME_WORDLIST=
# Example: PHISHINTEL_USERNAME_RULES=wordlists/username_rules.json
PHISHINTEL_USERNAME_RULES=
# Example values: true / false
PHISHINTEL_USERNAME_OFFLINE=false
# Example values: true / false
PHISHINTEL_USERNAME_UPDATE_SITES=false
# Example values: true / false
PHISHINTEL_NO_COLOR=false

# Storage
# Example: PHISHINTEL_HISTORY_FILE=data/history.jsonl
PHISHINTEL_HISTORY_FILE=data/history.jsonl

# Resource parser limits
PHISHINTEL_RESOURCE_MAX_PAGES=500
PHISHINTEL_RESOURCE_MAX_DEPTH=8